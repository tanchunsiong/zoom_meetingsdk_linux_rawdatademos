# Server
PORT=3090
HOST=0.0.0.0
CUSTCREATE_EMAIL_DOMAIN=loadtest.invalid

# Hosted manager server-side Basic Authentication
MANAGER_AUTH_USERNAME=admin
MANAGER_AUTH_PASSWORD=change-me

# Zoom Server-to-Server OAuth
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_API_BASE_URL=https://api.zoom.us/v2

# Meeting SDK JWT/signature service used by the ECS runners.
MEETING_TOKEN_ENDPOINT=https://your-token-service.example/meeting

# RTMS control plane
ZOOM_RTMS_CLIENT_ID=
ZOOM_WEBHOOK_SECRET_TOKEN=

# ECS Fargate runner
AWS_REGION=us-east-1
ECS_CLUSTER=
ECS_TASK_DEFINITION=
ECS_TASK_FAMILY=zoom-sendraw-loadtest-meeting
ECS_CONTAINER_NAME=zoom-sendraw-loadtest-meeting
ECS_SUBNETS=
ECS_SECURITY_GROUPS=
ECS_ASSIGN_PUBLIC_IP=true
ECS_LAUNCH_TYPE=FARGATE
ECS_PLATFORM_VERSION=LATEST
ECS_TASK_CPU=256
ECS_TASK_MEMORY=512
ECS_MAX_TASKS=10
ECS_PROJECT=zoom-loadtest-meeting

# Legacy local Docker settings
# ECS uses the task execution IAM role to pull from ECR. Do not store the
# temporary ECR login password here.
DOCKER_REGISTRY_URL=<account-id>.dkr.ecr.<region>.amazonaws.com
DOCKER_REGISTRY_USERNAME=AWS
DOCKER_REGISTRY_PASSWORD=
DOCKER_IMAGE=<account-id>.dkr.ecr.<region>.amazonaws.com/zoom-sendraw-loadtest-meeting:latest
DOCKER_PROJECT=zoom-loadtest-meeting
DOCKER_RESTART_POLICY=no
DOCKER_SHM_SIZE=256m
DOCKER_CPU_MIN=0.1
DOCKER_CPU_MAX=0.5
DOCKER_MEMORY_MIN=200m
DOCKER_MEMORY_MAX=500m
DOCKER_NETWORK=
DOCKER_LOGIN_BEFORE_RUN=false
